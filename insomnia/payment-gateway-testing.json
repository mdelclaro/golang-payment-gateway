      "headers": [{"name": "Accept", "value": "application/json"}],
      "body": {},
      "scripts": {
        "afterResponse": "insomnia.test('returns HTTP 200', () => { insomnia.expect(insomnia.response.code).to.eql(200); });\ninsomnia.test('returns the created payment', () => { const payment = insomnia.response.json(); insomnia.expect(String(payment.id)).to.eql(insomnia.environment.get('payment_id')); insomnia.expect(payment).to.have.property('cardLastFour'); insomnia.expect(payment).to.not.have.property('cardNumber'); insomnia.expect(payment).to.not.have.property('cvv'); });"
