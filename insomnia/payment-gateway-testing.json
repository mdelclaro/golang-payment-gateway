        "text": "{\n  \"cardNumber\": \"4111111111111111\",\n  \"expiryMonth\": 12,\n  \"expiryYear\": 2035,\n  \"currency\": \"USD\",\n  \"amount\": 2500,\n  \"cvv\": \"123\"\n}"
      },
      "scripts": {
        "afterResponse": "insomnia.test('creates the payment', () => { insomnia.expect(insomnia.response.code).to.eql(201); });\nconst payment = insomnia.response.json();\ninsomnia.test('returns payment details', () => { ['id', 'status', 'cardLastFour', 'expiryMonth', 'expiryYear', 'currency', 'amount'].forEach(key => insomnia.expect(payment).to.have.property(key)); insomnia.expect(payment.status).to.be.oneOf(['Authorized', 'Declined']); });\ninsomnia.test('does not expose card number or CVV', () => { insomnia.expect(payment).to.not.have.property('cardNumber'); insomnia.expect(payment).to.not.have.property('cvv'); });\ninsomnia.environment.set('payment_id', String(payment.id));"
      },
      "authentication": {},
      "settings": {"renderRequestBody": true, "encodeUrl": true, "rebuildPath": true, "followRedirects": "global", "cookies": {"send": true, "store": true}},
